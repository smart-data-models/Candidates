      "type": "string",
      "format": "uri",
      "description": "Property. Unique identifier of the entity."
    },
    "type": {
      "type": "string",
      "enum": [
        "Object"
      ],
      "description": "Property. NGSI-LD Entity type. It must be equal to 'Object'"
    },
