      "type": "string",
      "format": "uri",
      "description": "Property. Unique identifier of the entity."
    },
    "type": {
      "type": "string",
      "enum": [
        "Assay"
      ],
      "description": "Property. NGSI-LD Entity type. It must be equal to 'Assay'"
    },
    "name": {
      "type": "string",
      "description": "Property. Model:'https://schema.org/name'. The name of this item."
    },
    "description": {
      "type": "string",
      "description": "Property. Model:'https://schema.org/description'. A description of this item."
    },
