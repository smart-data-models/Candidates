      "type": "string",
      "description": "Property. A sequence of characters identifying the provider of the harmonised data entity."
    },
    "pmdClass": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "alloy crystal",
          "bar",
          "billet",
          "ceramic crystal",
          "coil (coiled sheet)",
