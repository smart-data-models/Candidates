{
  "id": "urn:ngsi-ld:ManufacturingProcess:bam-s355-testpiece-preparation",
  "type": "ManufacturingProcess",
  "name": {
    "type": "Property",
    "value": "Preparation of S355 tensile test pieces"
  },
  "description": {
    "type": "Property",
    "value": "Machining of flat tensile test pieces (E6x20x60) out of the S355 steel sheet, in rolling direction (Zx), transverse (Zy) and diagonal (Zd). Illustrative: process class and participants are assumed."
  },
  "pmdClass": {
    "type": "Property",
    "value": [
      "machining geometrically defined"
    ]
  },
  "hasSpecifiedInput": {
    "type": "Relationship",
    "object": [
      "urn:ngsi-ld:Material:bam-s355-sheet-pmdao-onto-1"
    ]
  },
  "hasSpecifiedOutput": {
    "type": "Relationship",
    "object": [
      "urn:ngsi-ld:Object:bam-s355-testpiece-zx2"
    ]
  },
  "precedes": {
    "type": "Relationship",
    "object": [
      "urn:ngsi-ld:Assay:pmdao-tto-tt-S355-2"
    ]
  },
  "isSubjectOf": {
    "type": "Property",
    "value": [
      "DIN EN ISO 6892-1"
    ]
  },
  "source": {
    "type": "Property",
    "value": "Illustrative example, partly synthetic: the BAM dataset (Zenodo 10.5281/zenodo.6778336, CC-BY-4.0) states only that the test pieces were taken from the S355 sheet in rolling direction; the process class and its participants are assumed. Classes and relations from PMD Core Ontology 3.1.2, CC-BY-4.0, Plattform MaterialDigital, https://w3id.org/pmd/co"
  },
  "@context": [
    "https://raw.githubusercontent.com/smart-data-models/Candidates/master/standards/pmd-core-ontology/models/ManufacturingProcess/context.jsonld"
  ]
}
