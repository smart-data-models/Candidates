          "description": "Property. Model:'https://w3id.org/emmo#EMMO_faf79f53_749d_40b2_807c_d34244c192f4'. EMMO numberValue of the numerical part (hasNumericalPart) of the quantity value."
        },
        "hasMeasurementUnit": {
          "type": "string",
          "description": "Property. Model:'https://w3id.org/emmo#EMMO_bed1d005_b04e_4a90_94cf_02bc678a8569'. EMMO hasMeasurementUnit: the skos:prefLabel of the EMMO MeasurementUnit individual, verbatim (e.g. GigaPascal, KilogramPerCubicMetre, DegreeCelsius); 1609 unit individuals in EMMO 1.0.4, each resolving to https://w3id.org/emmo#<label> or an EMMO_ IRI."
        },
        "standardUncertainty": {
          "type": "number",
          "description": "Property. Model:'https://w3id.org/emmo#EMMO_bba7f0f0_3707_42b9_b3fa_fd04610ef147'. EMMO standardUncertainty, in the same unit as numberValue."
        }
