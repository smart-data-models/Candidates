{
  "id": "urn:ngsi-ld:Assay:pmdao-tto-tt-S355-2",
  "type": "Assay",
  "name": {
    "type": "Property",
    "value": "Tensile test pmdao-tto-tt-S355-2 on test piece Zx2"
  },
  "description": {
    "type": "Property",
    "value": "Tensile test at room temperature (20 degC) according to DIN EN ISO 6892-1, extensometer removed after 3.9 % strain, no increase of test speed. Performed at BAM, Berlin, project PMDao-onto_1."
  },
  "pmdClass": {
    "type": "Property",
    "value": [
      "tensile testing process"
    ]
  },
  "hasSpecifiedInput": {
    "type": "Relationship",
    "object": [
      "urn:ngsi-ld:Object:bam-s355-testpiece-zx2"
    ]
  },
  "hasSpecifiedOutput": {
    "type": "Relationship",
    "object": [
      "urn:ngsi-ld:MeasurementDatum:pmdao-tto-tt-S355-2-ReH",
      "urn:ngsi-ld:MeasurementDatum:pmdao-tto-tt-S355-2-Rm",
      "urn:ngsi-ld:MeasurementDatum:pmdao-tto-tt-S355-2-E",
      "urn:ngsi-ld:MeasurementDatum:pmdao-tto-tt-S355-2-A",
      "urn:ngsi-ld:MeasurementDatum:pmdao-tto-tt-S355-2-Z"
    ]
  },
  "hasParticipant": {
