{
  "id": "urn:ngsi-ld:Material:bam-s355-sheet-pmdao-onto-1",
  "type": "Material",
  "name": {
    "type": "Property",
    "value": "S355 (1.0577) structural steel, sheet of the PMD S355 reference dataset"
  },
  "description": {
    "type": "Property",
    "value": "Portion of S355 (material number 1.0577) structural steel, designation according to DIN EN 10025-2:2019, making up the steel sheet from which the tensile test pieces Zx1-Zx4, Zy1-Zy3 and Zd2-Zd3 were taken."
  },
  "pmdClass": {
    "type": "Property",
    "value": [
      "steel",
      "structural material"
    ]
  },
  "isSpecifiedInputOf": {
    "type": "Relationship",
    "object": [
      "urn:ngsi-ld:ManufacturingProcess:bam-s355-testpiece-preparation"
    ]
  },
  "source": {
    "type": "Property",
    "value": "Real data: test piece Zx2 (process pmdao-tto-tt-S355-2) of 'Full dataset of several mechanical tests on an S355 steel sheet as reference data for digital representations', Bundesanstalt fuer Materialforschung und -pruefung (BAM), Zenodo https://doi.org/10.5281/zenodo.6778336, CC-BY-4.0 (also mapped to PMDco in https://github.com/materialdigital/tensile-test-ontology). Classes and relations from PMD Core Ontology 3.1.2, CC-BY-4.0, Plattform MaterialDigital, https://w3id.org/pmd/co"
  },
  "@context": [
    "https://raw.githubusercontent.com/smart-data-models/Candidates/master/standards/pmd-core-ontology/models/Material/context.jsonld"
  ]
}
