  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$schemaVersion": "0.0.1",
  "$id": "https://raw.githubusercontent.com/smart-data-models/Candidates/master/standards/project-haystack/models/Network/schema.json",
  "modelTags": "ProjectHaystack,Haystack4,SmartBuildings,BuildingAutomation",
  "title": "Smart Data Models - Project Haystack - Network",
  "description": "Logical communications network between two or more devices. See the Haystack 'Devices' chapter chapter. (Project Haystack 4.0.0 entity 'network', Xeto spec ph::Network. Tag names verbatim; marker tags in hasTag.)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uri",
      "description": "Property. Unique identifier of the entity. Stands for the Haystack 'id' Ref tag."
    },
    "type": {
      "type": "string",
      "enum": [
        "Network"
      ],
      "description": "Property. NGSI-LD Entity type. It must be equal to 'Network'"
    },
    "dateCreated": {
      "type": "string",
      "format": "date-time",
      "description": "Property. Model:'https://schema.org/DateTime'. Entity creation timestamp."
    },
    "dateModified": {
      "type": "string",
      "format": "date-time",
      "description": "Property. Model:'https://schema.org/DateTime'. Timestamp of the last modification."
    },
    "source": {
      "type": "string",
      "description": "Property. A sequence of characters giving the original source of the entity data."
    },
    "dataProvider": {
      "type": "string",
      "description": "Property. A sequence of characters identifying the provider of the harmonised data entity."
    },
    "hasTag": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/marker"
      },
      "contains": {
        "const": "network"
      },
      "description": "Property. Model:'https://project-haystack.org/def/ph/4.0.0#hasTag'. The marker tags of the entity, verbatim Haystack tag names, as Haystack's own RDF export encodes markers (ph:hasTag). Must contain 'network'. It carries the entity subtype markers (e.g. network), the options chosen for Haystack choices and any other marker such as his, cur, writable or hvac. Values expand to the Haystack def IRIs in JSON-LD. Documentation: https://project-haystack.org/doc/docHaystack/Rdf#instances"
    },
    "dis": {
      "type": "string",
      "description": "Property. Model:'https://project-haystack.org/def/ph/4.0.0#dis'. Display name for an entity. See the Haystack 'Ontology' chapter chapter. Documentation: https://project-haystack.org/doc/lib-ph/dis"
    }
  },
